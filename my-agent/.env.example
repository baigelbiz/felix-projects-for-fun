# Used by main.py's Claude Agent SDK starter demo (optional — it uses your
# Claude Code login by default).
ANTHROPIC_API_KEY=your_api_key_here

# --- WhatsApp bridge (bot.js + agent_reply.py) ---

# Chat/tool-calling model for the WhatsApp agent.
GEMINI_API_KEY=your_gemini_api_key_here

# Still used for gpt-image-1 (generate_image tool) and Whisper (voice note
# transcription in bot.js) — the rest of the agent runs on Gemini.
OPENAI_API_KEY=your_openai_api_key_here

GIPHY_API_KEY=your_giphy_api_key_here
CLOSE_API_KEY=your_close_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# Geocoding API key (Google Cloud Console) — used by the reverse_geocode tool
# to turn a shared WhatsApp location pin into a readable address.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Linux servers only: path to system Chromium for Puppeteer (unset on Mac).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
